# GET! environment variables (template — copy to .env.local and fill in)

# ---- Supabase ---------------------------------------------------------------
# Created at https://app.supabase.com/ → project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used by API routes for privileged operations.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- LLM (OpenAI-compatible) ------------------------------------------------
# Any OpenAI-compatible /v1/chat/completions endpoint works (DeepSeek, Tencent
# MaaS / hunyuan, etc.). The env var names are kept as DEEPSEEK_* for legacy.
# Used server-side only; never read on the client.
#
# Examples:
#   - DeepSeek:    BASE_URL=https://api.deepseek.com           MODEL=deepseek-chat
#   - Tencent MaaS: BASE_URL=https://tokenhub.tencentmaas.com/v1 MODEL=hy3-preview
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- App --------------------------------------------------------------------
# Whitelisted login email. Only this address may access the app.
NEXT_PUBLIC_ALLOWED_EMAIL=419981975@qq.com

# ---- Tencent COS (cloud sync, no login required) ----------------------------
# Create a bucket at https://console.cloud.tencent.com/cos
# and fill in the credentials below. The sync API route (/api/cos/sync) uses
# these server-side; they are NEVER sent to the browser.
#
# SecretId / SecretKey: sub-account key with cos:PutObject + cos:GetObject on
#   the bucket. Create at https://console.cloud.tencent.com/cam
# Bucket:  e.g.  get-sync-1234567890   (full bucket name including AppId)
# Region:  e.g.  ap-guangzhou / ap-shanghai / ap-beijing
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
